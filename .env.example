# ==============================================================================
# Simvaya Dashboard - Environment Configuration Template
# Copy this file to .env.local for development, or add variables to Vercel/production.
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Neon Serverless PostgreSQL connection URL
DATABASE_URL=postgres://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require

# ── Authentication & Security ─────────────────────────────────────────────────
# 64-byte/128-char hex strings for signing administrative and customer JWTs
JWT_SECRET_ADMIN=your-admin-jwt-secret-here-64-hex-chars-min
JWT_SECRET_CUSTOMER=your-customer-jwt-secret-here-64-hex-chars-min

# 32-byte (64 hex characters) AES-256-GCM key for encrypting eSIM supplier credentials in DB
ESIM_CREDENTIALS_ENCRYPTION_KEY=your-aes256-hex-encryption-key-here-64-chars

# Master passphrase or 32+ char secret for encrypting transient EVM deposit wallet private keys
CRYPTO_MASTER_SECRET=your-bep20-master-crypto-secret-key-32b-secure!

# ── Crypto Payment Gateway (BNB Smart Chain BEP-20) ───────────────────────────
# Cold storage EVM wallet address where all customer USDT is swept to
COLD_WALLET_ADDRESS=your-cold-wallet-address-here

# Dedicated Gas Relayer Funder Wallet (auto-funds micro-BNB to deposit addresses for USDT sweep)
GAS_FUNDER_ADDRESS=your-gas-funder-address-here
GAS_FUNDER_PRIVATE_KEY=your-gas-funder-wallet-private-key-hex

# ── Rate Limiting Thresholds (Configurable) ───────────────────────────────────
# Max consecutive failed auth attempts before exponential backoff kicks in
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
# Auth tracking window in seconds (default: 900s = 15 minutes)
RATE_LIMIT_AUTH_WINDOW_SEC=900
# Initial delay step in seconds for exponential backoff (e.g. 15s, 30s, 60s...)
RATE_LIMIT_AUTH_BASE_DELAY_SEC=15
# Maximum delay cap for backoff (default: 900s = 15 minutes)
RATE_LIMIT_AUTH_MAX_DELAY_SEC=900

# Public endpoint requests permitted per minute per IP (e.g. AI chat, crypto session, geo)
RATE_LIMIT_PUBLIC_MAX=60

# Authenticated user actions permitted per minute per user/session
RATE_LIMIT_AUTH_USER_MAX=180

# ── AI Travel Assistant (Google Gemini via Google AI Studio) ──────────────────
# Google AI Studio API key for /api/ai/chat (https://aistudio.google.com/)
GEMINI_API_KEY=
